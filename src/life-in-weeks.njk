---
title: Life in Weeks
layout: layouts/page
start_date: 1985-02-11
end_year: 2086
---
<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>

<div class="life-weeks-table">
  {% for week in lifeData %}
    {% if week %}
      {# Set tooltips #}
      {% set tooltip = "Week " ~ (week.index + 1) ~ " / " ~ week.weekStart %}

      {% if week.events.length %}
        {% set tooltip = tooltip + "<br>" %}
        {% for event in week.events %}
          {% set tooltip = tooltip + event.icon + " " + event.name %}
          {% if not loop.last %}{% set tooltip = tooltip + "<br>" %}{% endif %}
        {% endfor %}
      {% endif %}

      {% if week.timespans.length %}
        {% set tooltip = tooltip + "<br>" %}
        {% for span in week.timespans %}
          {% set tooltip = tooltip + span.icon + " " + span.name %}
          {% if not loop.last %}{% set tooltip = tooltip + "<br>" %}{% endif %}
        {% endfor %}
      {% endif %}

      <div
        class="week-box{% if week.isPast %} past{% endif %}"
        data-tippy-content="{{ tooltip | safe }}"
      >
        {% for event in week.events %}
          {% if not event.hide_from_grid %}
            <span class="event-icon">{{ event.icon }}</span>
            <span class="event-name">{{ event.name }}</span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
.life-weeks-table {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s03);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
}

.week-box {
  height: 2rem;
  padding: 6px 10px;
  border: 2px solid #B6C8A9;
  border-radius: var(--s02);
  background-color: white;
  box-sizing: border-box;

  display: flex;
  align-items: center;
  gap: var(--s03);

  font-size: 1rem;
  cursor: default;
  white-space: nowrap;
  transition: background-color 0.2s ease;
}

.week-box.past {
  background-color: #C8EAD3;
}

.week-box:hover {
  background-color: #CFFFE5;
  color: #695958;
}

.event-icon {
  flex-shrink: 0;
  font-size: 1.1em;
}

.event-name {
  white-space: nowrap;
}

.tippy-box {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    tippy('.week-box', {
      allowHTML: true,
      placement: 'top',
      theme: 'light-border',
    });
  });
</script>

---
title: Life in Weeks
layout: layouts/page
start_date: 1985-02-11
end_year: 2086
---
<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>

<div class="life-weeks-table">
  {% set weeksPerRow = 52 %}
  {% set years = (lifeData | length / weeksPerRow) | round(0, 'ceil') %}
  {% for yearIndex in range(0, years) %}
    <div class="year-row">
      <div class="year-label">
        {% if yearIndex == 0 or yearIndex % 5 == 0 %}
          {{ yearIndex }}
        {% endif %}
      </div>
      <div class="weeks-row">
        {% for weekIndex in range(0, weeksPerRow) %}
          {% set week = lifeData[yearIndex * weeksPerRow + weekIndex] %}
          {% if week %}
            {% set tooltip = "Week " ~ (week.index + 1) ~ " / " ~ week.weekStart %}
            {% if week.events.length %}
              {% set tooltip = tooltip + "<br>" %}
              {% for event in week.events %}
                {% set tooltip = tooltip + event.icon + " " + event.name %}
                {% if not loop.last %}{% set tooltip = tooltip + "<br>" %}{% endif %}
              {% endfor %}
            {% endif %}
            <div
              class="week-box{% if week.isPast %} past{% endif %}"
              data-tippy-content="{{ tooltip | safe }}"
            >
              {% for event in week.events %}
                {{ event.icon }}
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>

<style>
.life-weeks-table {
  display: flex;
  flex-direction: column;
  {# gap: var(--s05); #}
}

.year-row {
  display: flex;
  align-items: center;
  font-weight: bold;
}

.year-label {
  width: 32px;
  text-align: right;
  font-size: 12px;
  margin-right: 6px;
  flex-shrink: 0;
}

.weeks-row {
  display: flex;
}

.week-box {
  width: 1.2rem;
  height: 1.2rem;
  border: 1px solid #ccc;
  margin: 1px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  transition: background 0.2s;
}

.week-box.past {
  background-color: #dbeafe;
}

.week-box:hover {
  background-color: #a5b4fc;
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    tippy('.week-box', {
      allowHTML: true,
      placement: 'top',
      theme: 'light-border',
    });
  });
</script>

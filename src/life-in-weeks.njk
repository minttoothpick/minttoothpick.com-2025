---
title: Life in Weeks
layout: layouts/page
start_date: 1985-02-11
end_year: 2086
---
<!-- In your base layout or in the head of your page -->
<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>

<div class="weeks-grid">
  {% for week in lifeData %}
    {% set tooltip = "Week " ~ (week.index + 1) ~ " / " ~ week.weekStart %}
    {% if week.events.length %}
      {% set tooltip = tooltip + "<br>" %}
      {% for event in week.events %}
        {% set tooltip = tooltip + event.icon + " " + event.name %}
        {% if not loop.last %}{% set tooltip = tooltip + "<br>" %}{% endif %}
      {% endfor %}
    {% endif %}
    <div
      class="week-box{% if week.isPast %} past{% endif %}"
      data-tippy-content="{{ tooltip | escape }}"
      tabindex="0"
    >
      {% if week.events.length %}
        {# Output all icons for this week #}
        {% for event in week.events %}
          {{ event.icon }}
        {% endfor %}
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
.weeks-grid {
  display: flex;
  flex-wrap: wrap;
  max-width: 1100px;
}

.week-box {
  position: relative;
  width: 20px;
  height: 20px;
  border: 1px solid #ccc;
  margin: 1px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  cursor: pointer;
}

.week-box.past {
  background-color: #dbeafe; /* light blue */
}

.week-box:hover {
  background-color: rgba(0,0,0,0.1);
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    tippy('.week-box', {
      allowHTML: true,
      placement: 'top',
      theme: 'light-border',
    });
  });
</script>

---
title: Life in Weeks
layout: layouts/page
start_date: 1985-02-11
end_year: 2086
---
<div class="weeks-grid">
  {% for week in lifeData %}
    <div class="week-box" title="{{ week.weekStart }}">
      {% if week.events.length %}
        {# Output all icons for this week #}
        {% for event in week.events %}
          {{ event.icon }}
        {% endfor %}
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
.weeks-grid {
  display: flex;
  flex-wrap: wrap;
  max-width: 1100px;
}
.week-box {
  width: 14px;
  height: 14px;
  border: 1px solid #ccc;
  margin: 1px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}
</style>